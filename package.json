{
  "name": "trudhome",
  "version": "1.0.1",
  "description": "trudbot's borwser start page.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx rollup -c rollup.dev.config.mjs --watch",
    "build": "npx rollup -c rollup.prod.config.mjs",
    "build:ext": "npx rollup -c rollup.ext.config.mjs --environment BROWSER:chrome",
    "build:ext:firefox": "npx rollup -c rollup.ext.config.mjs --environment BROWSER:firefox",
    "release:tag": "git tag v$(node -p \"require('./package.json').version\") && git push origin v$(node -p \"require('./package.json').version\")"
  },
  "author": "trudbot",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "caniuse-lite": "^1.0.30001799",
    "chalk": "^5.6.2",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.4",
    "rollup": "^4.62.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-string": "^3.0.0"
  },
  "dependencies": {
    "fetch-jsonp": "^1.4.0",
    "webextension-polyfill": "^0.12.0"
  },
  "engines": {
    "node": ">=22.8.0",
    "npm": ">=10.8.2"
  }
}
